datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
}

model Brand {
  id        String        @id @default(uuid())
  name      String        @unique
  logoUrl   String?
  username  String?       @unique
  password  String
  products  Product[]
  dealers   Dealer[]
  campaigns AdCampaign[]
  analytics AnalyticsLog[]
  saas      SaaSConfig[]
  podiumBids PodiumBid[]
  outletListings OutletListing[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Product {
  id         String         @id @default(uuid())
  name       String
  code       String         @unique
  brandId    String
  brand      Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  width      Float          // in cm, e.g., 60
  height     Float          // in cm, e.g., 120
  color      String         // e.g., "Antrasit", "Bej"
  finish     String         // e.g., "Mat", "Parlak", "Lapatto"
  style      String         // e.g., "Mermer", "Ahşap", "Beton"
  area       String         // e.g., "Banyo,Mutfak" (comma-separated string for SQLite compatibility)
  imageUrl   String         // product thumbnail
  textureUrl String?        // detailed high-res texture for 3D tiling
  isPremium  Boolean        @default(false)
  
  // Marketplace and home improvement store integration
  trendyolPrice    Float?
  trendyolUrl      String?
  hepsiburadaPrice Float?
  hepsiburadaUrl   String?
  n11Price         Float?
  n11Url           String?
  koctasPrice      Float?
  koctasUrl        String?
  bauhausPrice     Float?
  bauhausUrl       String?
  yerevdekorPrice  Float?
  yerevdekorUrl    String?

  leads      Lead[]
  campaigns  AdCampaign[]
  analytics  AnalyticsLog[]
  favorites  Favorite[]
  sampleOrders SampleOrder[]
  dealerInventories DealerInventory[]
  outletListings OutletListing[]
  podiumBids PodiumBid[]
  
  // Technical Specifications
  peiRating        Int?           // Wear resistance rating (1-5)
  slipResistance   String?        // Slip resistance rating (e.g., "R9", "R10", "R11")
  frostResistance  Boolean?       // Whether it is frost resistant
  thickness        Float?         // Thickness in mm (e.g., 9.5)
  rectified        Boolean?       // Whether it has rectified edges

  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([brandId])
  @@index([code])
  @@index([isPremium])
}

model Dealer {
  id        String   @id @default(uuid())
  name      String
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  phone     String
  email     String?
  password  String
  status    String   @default("APPROVED") // PENDING_APPROVAL, APPROVED, REJECTED
  address   String
  city      String   // e.g., "İstanbul"
  district  String   // e.g., "Kadıköy"
  lat       Float
  lng       Float
  leads     Lead[]
  sampleOrders SampleOrder[]
  saas      DealerSaaSConfig[]
  inventories DealerInventory[]
  stockExchanges DealerStockExchange[]
  xmlFeedUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Showroom & Profile Customizations
  logoUrl         String?
  bannerUrl       String? // Custom hero banner background image URL
  showroomImages  String? // Comma-separated string of image URLs
  virtualTourUrl  String? // 3D Showroom / Virtual Tour Link (Matterport, 360 etc.)
  specialConcepts String? // Special concepts showcased in showroom
  aboutText         String?
  logisticsServices String?
  featuredProducts  String?
  dealerCampaigns   String?
  referenceProjects  String?
  dealerFaqs        String?
  dealerStats       String?
  pdfCatalogUrl     String?
  pdfCatalogName    String?
  themePreset       String?  @default("GOLD")
  themePrimary      String?  @default("#d4af37")
  analytics         AnalyticsLog[]
  outletListings    OutletListing[]

  @@index([city, district])
  @@index([brandId])
  @@index([status])
}

model DealerSaaSConfig {
  id             String    @id @default(uuid())
  dealerId       String
  dealer         Dealer    @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  plan           String    // LITE, STANDART, PREMIUM
  status         String    @default("ACTIVE") // ACTIVE, EXPIRED, PAUSED, PENDING_APPROVAL
  expiresAt      DateTime
  pendingPlan    String?
  pendingStatus  String?
  paymentSender  String?
  paymentDate    String?
  paymentNote    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}


model Lead {
  id                 String   @id @default(uuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  dealerId           String
  dealer             Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  clientName         String
  clientPhone        String
  clientEmail        String
  notes              String?
  status             String   @default("PENDING") // PENDING, RESPONDED, COMPLETED
  
  // New columns for Usta and Architect integration
  requestedUsta      Boolean  @default(false)
  requestedArchitect Boolean  @default(false)
  projectDimensions  String?
  projectPhotoUrl    String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model AdCampaign {
  id           String    @id @default(uuid())
  brandId      String
  brand        Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  productId    String
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  bidAmount    Float     @default(0) // Obsolete/CPC fallback
  status       String    @default("PENDING_APPROVAL") // PENDING_APPROVAL, ACTIVE, PAUSED, EXPIRED, REJECTED
  budget       Float     @default(0) // Remaining budget / price paid
  clicks       Int       @default(0)
  impressions  Int       @default(0)
  studioTries  Int       @default(0)
  durationDays Int       @default(7) // 7 (1 week), 30 (1 month), 90 (3 months), 180 (6 months)
  paymentRef   String?   // bank transfer reference/dekont no
  price        Float     @default(0) // Price paid for campaign
  expiresAt    DateTime? // calculated expiration timestamp
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model PodiumBid {
  id           String    @id @default(uuid())
  brandId      String
  brand        Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  productId    String
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  weekNumber   Int       // ISO week number (1-53)
  year         Int       // Year (e.g. 2026)
  bidAmount    Float     // Bid in TL (e.g. 5000.0)
  paymentRef   String?   // Dekont / Bank transfer reference
  status       String    @default("PENDING_APPROVAL") // PENDING_APPROVAL, WINNER_ACTIVE, OUTBID, REJECTED, EXPIRED
  title        String?   // Slogan / Campaign Title e.g., "Yeni Lüks Mermer Koleksiyonu"
  description  String?   // Promotional detail text
  clicks       Int       @default(0)
  studioTries  Int       @default(0)
  impressions  Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([weekNumber, year])
  @@index([status])
  @@index([brandId])
}

model AnalyticsLog {
  id        String   @id @default(uuid())
  action    String   // SEARCH, VIEW, CLICK, LEAD, WHATSAPP, PHONE, DIRECTIONS, PDF_DOWNLOAD
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  brandId   String?
  brand     Brand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  dealerId  String?
  dealer    Dealer?  @relation(fields: [dealerId], references: [id], onDelete: SetNull)
  query     String?  // search queries if action is SEARCH
  city      String?  // user's city
  country   String?  // user's country code (e.g. DE, AE, GB, US, TR)
  createdAt DateTime @default(now())

  @@index([action])
  @@index([createdAt])
  @@index([country])
}

model SaaSConfig {
  id             String    @id @default(uuid())
  brandId        String
  brand          Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  plan           String    // BASIC, PRO, ENTERPRISE
  status         String    @default("ACTIVE") // ACTIVE, EXPIRED, PAUSED, PENDING_APPROVAL
  expiresAt      DateTime
  pendingPlan    String?
  pendingStatus  String?
  paymentSender  String?
  paymentDate    String?
  paymentNote    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model User {
  id                String     @id @default(uuid())
  name              String
  email             String     @unique
  password          String
  resetToken        String?
  resetTokenExpires DateTime?
  favorites         Favorite[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model ProjectRequest {
  id               String   @id @default(uuid())
  companyName      String
  contactName      String
  contactPhone     String
  contactEmail     String
  projectName      String
  projectType      String   // Konut, Ofis, Otel, AVM, Hastane, Diğer
  city             String
  district         String
  constructionStep String   // Kaba İnşaat, İnce İşler, Bitmek Üzere, Restorasyon
  quantityM2       Int      // e.g. 5000
  ceramicStyles    String   // comma-separated choices: "Mermer,Beton"
  ceramicSizes     String   // comma-separated choices: "60x120,80x80"
  ceramicColors    String?  // e.g. "Gri, Antrasit"
  ceramicFinishes  String?  // e.g. "Mat, Lapatto"
  usageAreas       String   // comma-separated choices: "Zemin,Islak Hacim"
  budgetM2         String   // e.g. "Düşük (0-300 TL)", "Orta (300-600 TL)", "Yüksek (600+ TL)"
  deliveryTimeline String   // e.g. "30 gün içinde", "90 gün içinde"
  notes            String?
  status           String   @default("PENDING") // PENDING, APPROVED, COMPLETED, REJECTED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DealerInventory {
  id        String   @id @default(uuid())
  dealerId  String
  dealer    Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  stock     Float    @default(0) // Stock quantity in m² or boxes
  price     Float?   // Optional custom dealer price
  status    String   @default("IN_STOCK") // IN_STOCK, DISPLAY_ONLY, ORDER_ONLY
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dealerId, productId])
}

model OutletListing {
  id            String   @id @default(uuid())
  dealerId      String?
  dealer        Dealer?  @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  brandId       String?
  brand         Brand?   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  title         String
  category      String   @default("PROJE_FAZLASI") // PROJE_FAZLASI, SERI_SONU, IKINCI_KALITE, OUTLET
  badgeTag      String?  @default("Kapatıyoruz / Proje Fazlası") // e.g. "Kapatıyoruz / Proje Fazlası", "Şok Fiyat", "Son Paletler"
  quantityM2    Float    @default(0) // Quantity in m²
  unitPrice     Float    // Outlet price per m²
  originalPrice Float?   // Original reference price per m²
  dimensions    String?  // e.g., "60x120 cm"
  colorFinish   String?  // e.g., "Mat Antrasit"
  imageUrl      String?
  notes         String?  // Condition description or batch details
  status        String   @default("ACTIVE") // ACTIVE, RESERVED, SOLD
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model OutletAlert {
  id        String   @id @default(uuid())
  name      String
  phone     String
  city      String   @default("ALL") // e.g., "İstanbul", "Ankara" or "ALL"
  category  String   @default("ALL") // e.g., "PROJE_FAZLASI", "SERI_SONU", "IKINCI_KALITE", "OUTLET", "ALL"
  status    String   @default("ACTIVE") // ACTIVE, PAUSED, CANCELLED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Installer {
  id                   String   @id @default(uuid())
  name                 String
  companyName          String?
  phone                String
  city                 String   // e.g. "İstanbul", "Ankara"
  district             String?  // e.g. "Kadıköy", "Çankaya"
  experienceYears      Int      @default(10)
  specialties          String   // e.g. "60x120 Ebat Karo, Banyo Yenileme, Teras Su İzolasyonu"
  rating               Float    @default(4.9)
  reviewCount          Int      @default(12)
  verified             Boolean  @default(true)
  guaranteeBadge       Boolean  @default(true) // Lazer Terazili & Derz Artılı İş Teslim Garantili
  contractRateM2       String?  @default("250 ₺/m²") // Sample m² labor contract rate
  portfolioBeforeAfter String?  // JSON string containing array of { beforeUrl, afterUrl, title, areaM2 }
  imageUrl             String?
  notes                String?  // Short bio or work portfolio notes
  status               String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    String   @default("UNREAD") // UNREAD, READ, REPLIED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SampleOrder {
  id             String   @id @default(uuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  dealerId       String?
  dealer         Dealer?  @relation(fields: [dealerId], references: [id], onDelete: SetNull)
  clientName     String
  clientPhone    String
  clientEmail    String
  city           String
  district       String
  address        String
  notes          String?
  status         String   @default("PENDING") // PENDING, SHIPPED, DELIVERED, CANCELLED
  trackingNumber String?
  cargoCompany   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model DealerStockExchange {
  id           String   @id @default(uuid())
  dealerId     String?
  dealer       Dealer?  @relation(fields: [dealerId], references: [id], onDelete: SetNull)
  type         String   // NEED_STOCK (Stok Aranıyor), HAVE_STOCK (Fazla Stok / Takaslık)
  productName  String
  brandName    String?
  quantityM2   Int      @default(10)
  city         String   @default("İstanbul")
  district     String?
  urgent       Boolean  @default(true)
  notes        String?
  contactName  String
  contactPhone String
  status       String   @default("OPEN") // OPEN, MATCHED, CLOSED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

